{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bootstrap-sha": "2bd44f59837ee3dcbb611e1234ded60b3be8acfc",
  "packages": {
    ".": {
      "package-name": "ha-aoe2",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/aoe2/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='ha-aoe2')].version"
        }
      ]
    }
  }
}
